# Variables d'environnement à configurer dans Vercel Dashboard
# Settings > Environment Variables

# Sous-domaine de votre instance wheelsys (ex: "lutam" pour lutam.wheelsys.io)
WHEELSYS_TENANT=lutam

# Clé secrète pour signer les sessions (chaîne aléatoire longue)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=votre_cle_secrete_aleatoire_ici

# Plus besoin de WHEELSYS_USERNAME / WHEELSYS_PASSWORD / APP_USERS
# Chaque utilisateur se connecte avec son propre compte wheelsys
